from langchain_core.documents import Document
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_openai import OpenAIEmbeddings
from langchain_community.vectorstores import FAISS
import os


# =========================================
# CONFIGURE API KEY
# =========================================

api_key = os.environ.get("OPENAI_API_KEY")

if not api_key:
    raise ValueError("API key is not configured.")


# =========================================
# CREATE DOCUMENTS
# =========================================

documents = [

    Document(
        page_content="Python is a programming language used in web development, data science and artificial intelligence."
    ),

    Document(
        page_content="Machine Learning enables computers to learn patterns from data and make predictions."
    ),

    Document(
        page_content="Cloud computing provides computing resources such as storage and servers through the Internet."
    )

]


# =========================================
# SPLIT DOCUMENTS INTO CHUNKS
# =========================================

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=100,
    chunk_overlap=20
)

chunks = text_splitter.split_documents(documents)


# =========================================
# DISPLAY CHUNKS
# =========================================

print("Number of chunks:", len(chunks))

for i, chunk in enumerate(chunks):
    print("\nChunk", i + 1)
    print(chunk.page_content)


# =========================================
# GENERATE EMBEDDINGS
# =========================================

embeddings = OpenAIEmbeddings()


# =========================================
# CREATE VECTOR STORE
# =========================================

vector_store = FAISS.from_documents(
    chunks,
    embeddings
)


# =========================================
# VERIFY VECTOR STORE
# =========================================

print("\nVector store created successfully.")
print("Number of indexed chunks:", len(chunks))
