import os
import json
import yaml
from openai import OpenAI


# =========================================
# API CONFIGURATION
# =========================================

api_key = os.environ.get("OPENAI_API_KEY")

if not api_key:
    raise ValueError("API key is not configured.")

client = OpenAI(api_key=api_key)


# =========================================
# DATASET
# =========================================

dataset_description = """
The dataset contains three books:

1. Title: The Alchemist
   Author: Paulo Coelho
   Publication Year: 1988

2. Title: 1984
   Author: George Orwell
   Publication Year: 1949

3. Title: Pride and Prejudice
   Author: Jane Austen
   Publication Year: 1813
"""


# =========================================
# BASIC JSON PROMPT
# =========================================

json_prompt = f"""
Convert the following book dataset into JSON.

{dataset_description}
"""

response_json = client.responses.create(
    model="YOUR_APPROVED_MODEL",
    input=json_prompt
)

json_output = response_json.output_text

print("=" * 70)
print("INITIAL JSON OUTPUT")
print("=" * 70)

print(json_output)


# =========================================
# JSON VALIDATION
# =========================================

print("\n")
print("=" * 70)
print("INITIAL JSON VALIDATION")
print("=" * 70)

try:
    json_data = json.loads(json_output)

    print("Valid JSON")
    print(json_data)

except json.JSONDecodeError as e:
    print("Invalid JSON")
    print("Error:", e)


# =========================================
# REFINED JSON PROMPT
# =========================================

refined_json_prompt = f"""
Convert the following book dataset into valid JSON.

Dataset:
{dataset_description}

Requirements:
1. Create one JSON object containing a key named "books".
2. The value of "books" must be an array.
3. Each book must contain exactly these fields:
   - title
   - author
   - publication_year
4. Use the exact information provided in the dataset.
5. Return only valid JSON.
6. Do not include Markdown code fences.
7. Do not include explanations or additional text.
"""

response_json_refined = client.responses.create(
    model="YOUR_APPROVED_MODEL",
    input=refined_json_prompt
)

json_output_refined = response_json_refined.output_text


# =========================================
# REFINED JSON VALIDATION
# =========================================

print("\n")
print("=" * 70)
print("REFINED JSON OUTPUT")
print("=" * 70)

print(json_output_refined)

print("\n")
print("=" * 70)
print("REFINED JSON VALIDATION")
print("=" * 70)

try:
    json_data = json.loads(json_output_refined)

    print("Valid JSON")

    if "books" in json_data:
        print("Key 'books': FOUND")

        if isinstance(json_data["books"], list):
            print("Books is an array.")
            print("Number of books:",
                  len(json_data["books"]))

            for book in json_data["books"]:

                required_fields = {
                    "title",
                    "author",
                    "publication_year"
                }

                if isinstance(book, dict) and set(book.keys()) == required_fields:
                    print("Book structure: CORRECT")
                else:
                    print("Book structure: INCORRECT")

except json.JSONDecodeError as e:
    print("Invalid JSON")
    print("Error:", e)


# =========================================
# YAML PROMPT
# =========================================

yaml_prompt = f"""
Convert the following book dataset into valid YAML.

{dataset_description}

Requirements:
- Create a top-level key named "books".
- Represent the three books as a list.
- Each book must contain:
  title
  author
  publication_year
- Return only YAML.
- Do not include explanations.
"""

response_yaml = client.responses.create(
    model="YOUR_APPROVED_MODEL",
    input=yaml_prompt
)

yaml_output = response_yaml.output_text


# =========================================
# YAML VALIDATION
# =========================================

print("\n")
print("=" * 70)
print("YAML OUTPUT")
print("=" * 70)

print(yaml_output)

print("\n")
print("=" * 70)
print("YAML VALIDATION")
print("=" * 70)

try:
    yaml_data = yaml.safe_load(yaml_output)

    print("Valid YAML")

    if isinstance(yaml_data, dict) and "books" in yaml_data:
        print("Key 'books': FOUND")

        if isinstance(yaml_data["books"], list):
            print("Books is a list.")
            print("Number of books:",
                  len(yaml_data["books"]))

            for book in yaml_data["books"]:
                print(book)

except yaml.YAMLError as e:
    print("Invalid YAML")
    print("Error:", e)


# =========================================
# RESULT
# =========================================

print("\n")
print("=" * 70)
print("EXPERIMENT COMPLETED")
print("=" * 70)

print("JSON and YAML generation and validation completed.")
